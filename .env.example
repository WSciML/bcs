# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Comma-separated recipients. Defaults to jack.krebsbach@colorado.edu.
# Until a domain is verified with Resend, this must be a single address — the
# one the Resend account is registered under. Resend rejects the whole send if
# any recipient is anyone else. Add the other founders once a domain is live.
CONTACT_TO=jack.krebsbach@colorado.edu

# Sender. Swap to an address on your own domain once it's verified in Resend.
CONTACT_FROM="BCS Contact Form <onboarding@resend.dev>"
